# Production Flask Configuration
FLASK_ENV=production
SECRET_KEY=change-this-to-a-secure-random-64-char-string-in-production

# Custom SQLite Database Path (Optional)
# DATABASE_PATH=/var/data/fitness_tracker.db

# Google OAuth 2.0 Credentials (Optional)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# AI Vision & Chat API Keys (Optional - Gemini / OpenAI)
GEMINI_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
